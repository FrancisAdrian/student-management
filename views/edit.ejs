<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Student</title>
  <style>
        /* ==========================================
        1. CSS VARIABLES & THEME CONFIGURATION
        ========================================== */
        :root {
        /* Blue Palette */
        --primary-blue: #1e40af;       /* Main Header & Accent */
        --primary-hover: #1d4ed8;      /* Darker blue on hover */
        --accent-blue: #3b82f6;       /* Action buttons & Highlights */
        --light-blue: #eff6ff;        /* Table row hover & active state */

        /* Gray Palette */
        --bg-gray: #f8fafc;           /* Main page background */
        --card-bg: #ffffff;           /* Table & container background */
        --text-main: #1e293b;         /* Primary text color */
        --text-muted: #64748b;        /* Subtitles & placeholders */
        --border-gray: #e2e8f0;       /* Table borders & dividers */
        --table-header-bg: #f1f5f9;  /* Table header fill */

        /* Utility Colors */
        --danger-red: #ef4444;
        --danger-hover: #dc2626;

        /* Typography & Layout Settings */
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        --border-radius: 6px;
        --box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
        }

        /* ==========================================
        2. GLOBAL RESETS & BASE STYLES
        ========================================== */
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        body {
        font-family: var(--font-sans);
        background-color: var(--bg-gray);
        color: var(--text-main);
        line-height: 1.5;
        }

        a {
        text-decoration: none;
        color: inherit;
        }

        /* ==========================================
        3. NAVIGATION BAR
        ========================================== */
        .navbar {
        background-color: var(--primary-blue);
        color: #ffffff;
        padding: 0.85rem 1.5rem;
        box-shadow: var(--box-shadow);
        }

        .nav-container {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        }

        .brand {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        }

        .nav-links {
        display: flex;
        gap: 1.25rem;
        }

        .nav-links a {
        font-size: 0.95rem;
        padding: 0.4rem 0.8rem;
        border-radius: var(--border-radius);
        transition: background-color 0.2s ease;
        }

        .nav-links a:hover,
        .nav-links a.active {
        background-color: rgba(255, 255, 255, 0.15);
        }

        /* ==========================================
        4. MAIN CONTAINER & PAGE HEADER
        ========================================== */
        .container {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1rem;
        }

        .page-header {
        margin-bottom: 1.25rem;
        }

        .page-header h2 {
        font-size: 1.5rem;
        color: var(--text-main);
        }

        /* ==========================================
        5. ACTION BAR (SEARCH & ADD BUTTON)
        ========================================== */
        .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
        background-color: var(--card-bg);
        padding: 1rem;
        border-radius: var(--border-radius);
        border: 1px solid var(--border-gray);
        box-shadow: var(--box-shadow);
        }

        .search-form {
        display: flex;
        gap: 0.5rem;
        flex: 1;
        max-width: 450px;
        }

        .search-input {
        width: 100%;
        padding: 0.5rem 0.8rem;
        font-size: 0.9rem;
        border: 1px solid var(--border-gray);
        border-radius: var(--border-radius);
        outline: none;
        transition: border-color 0.2s ease;
        }

        .search-input:focus {
        border-color: var(--accent-blue);
        }

        /* Buttons */
        .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: var(--border-radius);
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
        white-space: nowrap;
        }

        .btn-primary {
        background-color: var(--accent-blue);
        color: #ffffff;
        }

        .btn-primary:hover {
        background-color: var(--primary-hover);
        }

        .btn-secondary {
        background-color: var(--table-header-bg);
        color: var(--text-main);
        border: 1px solid var(--border-gray);
        }

        .btn-secondary:hover {
        background-color: var(--border-gray);
        }

        /* ==========================================
        6. RESPONSIVE STUDENT TABLE
        ========================================== */
        .table-responsive {
        background-color: var(--card-bg);
        border-radius: var(--border-radius);
        border: 1px solid var(--border-gray);
        box-shadow: var(--box-shadow);
        overflow-x: auto; /* Handles mobile scrolling */
        }

        .student-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.92rem;
        }

        .student-table th {
        background-color: var(--table-header-bg);
        color: var(--text-main);
        font-weight: 600;
        padding: 0.85rem 1rem;
        border-bottom: 2px solid var(--border-gray);
        }

        .student-table td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--border-gray);
        color: var(--text-main);
        }

        /* Zebra Striping & Hover */
        .student-table tbody tr:nth-child(even) {
        background-color: #fafafa;
        }

        .student-table tbody tr:hover {
        background-color: var(--light-blue);
        }

        /* Table Action Links */
        .actions {
        display: flex;
        gap: 0.5rem;
        }

        .btn-action {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        }

        .btn-action.edit {
        background-color: #e0f2fe;
        color: #0369a1;
        }

        .btn-action.edit:hover {
        background-color: #bae6fd;
        }

        .btn-action.delete {
        background-color: #fee2e2;
        color: #b91c1c;
        }

        .btn-action.delete:hover {
        background-color: #fca5a5;
        }

        /* ==========================================
        7. RESPONSIVE MEDIA QUERIES
        ========================================== */
        @media (max-width: 768px) {
        .nav-container {
            flex-direction: column;
            gap: 0.8rem;
        }

        .action-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-form {
            max-width: 100%;
        }

        .btn {
            text-align: center;
        }
    }
  </style>
</head>
<body>

  <header class="navbar">
    <div class="nav-container">
      <a href="/students" class="brand">StudentPortal</a>
      <nav class="nav-links">
        <a href="/students" class="active">Students</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <div class="page-header">
      <h2>Edit Student Details</h2>
    </div>

    <form action="/students/edit/<%= student.id %>" method="POST" class="form-container">
      <div class="form-group">
        <label for="student_id">Student ID:</label>
        <input type="text" id="student_id" name="student_id" value="<%= student.student_id %>" required class="search-input">
      </div>

      <div class="form-group">
        <label for="first_name">First Name:</label>
        <input type="text" id="first_name" name="first_name" value="<%= student.first_name %>" required class="search-input">
      </div>

      <div class="form-group">
        <label for="last_name">Last Name:</label>
        <input type="text" id="last_name" name="last_name" value="<%= student.last_name %>" required class="search-input">
      </div>

      <div class="form-group">
        <label for="course">Course:</label>
        <input type="text" id="course" name="course" value="<%= student.course %>" required class="search-input">
      </div>
      
      <div class="form-group">
        <label for="year_level">Year Level:</label>
        <input type="text" id="year_level" name="year_level" value="<%= student.year_level %>" required class="search-input">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/students" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>

</body>
</html>